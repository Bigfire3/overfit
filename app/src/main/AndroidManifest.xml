<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- KI-Anbieter (Ktor) und Übungsbilder der free-exercise-db (Coil). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Training/Pausentimer: Benachrichtigung (ab Android 13 mit Abfrage), Vibration, exakter Alarm zum Pausenende
         (vom Nutzer erlaubt; ohne Erlaubnis inexakt). Foreground-Service (specialUse) nur während eines Trainings,
         er hält die Trainings-Benachrichtigung. Kein Wakelock. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- QR-Scan beim Vorlagen-Import; ohne Kamera bleibt die App voll nutzbar. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".OverfitApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Overfit">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Geteilte Vorlagen: Web-Link (ohne autoVerify, öffnet sonst im Browser-Dialog) und App-Schema. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bigfire3.github.io" android:pathPrefix="/overfit/t" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="overfit" />
            </intent-filter>
            <!-- .overfit-Dateien (Mail, Messenger, Dateien-App). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/x-overfit" />
                <data android:scheme="file" android:mimeType="application/x-overfit" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.overfit" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.overfit" />
            </intent-filter>
            <!-- Datei mit unbekanntem Typ (WhatsApp, Downloads liefern oft application/octet-stream): Overfit prüft den Inhalt selbst. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- "Teilen mit …" aus Dateien-App, WhatsApp, Mail: .overfit-Datei an Overfit schicken. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-overfit" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Läuft nur von „Training starten“ bis „Training beenden/verwerfen“. Begründung für Play: siehe
             docs/DECISIONS.md „Trainings-Benachrichtigung“. -->
        <service
            android:name="app.overfit.platform.TrainingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Running workout session: an ongoing notification shows the current set or the rest countdown with actions (set done, +15 s, skip) from the moment the user starts a workout until they finish it." />
        </service>
        <receiver
            android:name="app.overfit.platform.RestAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="app.overfit.platform.RestDismissedReceiver"
            android:exported="false" />
        <receiver
            android:name="app.overfit.platform.RestTickReceiver"
            android:exported="false" />
        <receiver
            android:name="app.overfit.platform.RestActionReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
