// KI-Anbieter für das Guthaben: welches Modell hinter welcher Stufe steckt.
// Anleitung (ohne Programmieren, auch vom Handy): docs/anbieter-umstellen.md
//
// - "models": alle Modelle, die der Server kennt. Preise in US-Dollar je 1 Mio. Token (Listenpreis des Anbieters,
//   ohne Aufschlag; der Aufschlag MARKUP_BP kommt beim Abrechnen dazu). Preisänderung = nur hier die Zahl ändern
//   und neu deployen. Optional "since": ab diesem Datum (UTC) gilt der Preis (Liste mit mehreren Einträgen).
//   "cacheRead"/"cacheWrite" fehlen = wie "in". "reasoning": Modell denkt mit, zählt Denk-Token als Ausgabe
//   (bekommt mehr Ausgabe-Raum). "images": verarbeitet Fotos.
// - "presets": fertige Zuordnungen Stufe → Modell (+ Ausweich-Modell, auch bei einem anderen Anbieter).
//   Ausweichen passiert einmal, wenn das erste Modell ausfällt; berechnet wird dann das günstigere der beiden.
// - "default": Voreinstellung, wenn beim Deploy nichts ausgewählt ist.
// - "fallbackOrder": fehlt für die gewählte Voreinstellung ein Schlüssel, nimmt der Server die erste vollständige
//   aus dieser Liste (und der Deploy sagt das deutlich).
//
// Schlüssel je Anbieter (GitHub → Settings → Secrets and variables → Actions):
//   anthropic → ANTHROPIC_API_KEY · openai → OPENAI_API_KEY · gemini → GEMINI_API_KEY
//   openrouter → OPENROUTER_API_KEY · workers-ai → kein Schlüssel (Cloudflare-Konto, 10 000 Neurons/Tag frei)
//
// Nach einer Änderung einfach deployen: src/routing.gen.json wird bei jedem Test-, Typprüfungs- und Deploy-Lauf neu erzeugt.
{
  "usdToEur": 0.92,
  "default": "claude",
  "fallbackOrder": ["claude", "gemischt", "gemini", "openai", "openrouter", "gratis"],
  "models": {
    // Anthropic, Preisliste Stand 7.11.2026. Cache-Schreiben = 1,25 × Eingabe.
    "claude-haiku-5-5": { "provider": "anthropic", "displayName": "Claude Haiku 5.5", "vendor": "Anthropic", "images": true,
      "price": { "in": 0.10, "out": 0.50, "cacheRead": 0.01, "cacheWrite": 0.125 } },
    "claude-sonnet-5-5": { "provider": "anthropic", "displayName": "Claude Sonnet 5.5", "vendor": "Anthropic", "images": true,
      "price": { "in": 2, "out": 10, "cacheRead": 0.2, "cacheWrite": 2.5 } },
    "claude-opus-5-5": { "provider": "anthropic", "displayName": "Claude Opus 5.5", "vendor": "Anthropic", "images": true,
      "price": { "in": 4, "out": 20, "cacheRead": 0.2, "cacheWrite": 5 } },

    // OpenAI, Preisliste developers.openai.com (Stand 7.11.2026; vor Produktion prüfen).
    "gpt-5-mini": { "provider": "openai", "displayName": "GPT-5 mini", "vendor": "OpenAI", "images": true, "reasoning": true, "thinkingTokens": 800,
      "price": { "in": 0.25, "out": 2, "cacheRead": 0.025 } },
    "gpt-5": { "provider": "openai", "displayName": "GPT-5", "vendor": "OpenAI", "images": true, "reasoning": true, "thinkingTokens": 1500,
      "price": { "in": 1.25, "out": 10, "cacheRead": 0.125 } },

    // Google Gemini (Preise aus der früheren Stufe „standard“; ab 2027 doppelt so teuer).
    "gemini-3.6-flash": { "provider": "gemini", "displayName": "Gemini 3.6 Flash", "vendor": "Google", "images": true, "reasoning": true, "thinkingTokens": 1000,
      "price": [
        { "in": 0.75, "out": 3.75, "cacheRead": 0.075 },
        { "since": "2027-01-01", "in": 1.5, "out": 7.5, "cacheRead": 0.15 }
      ] },

    // Cloudflare Workers AI (über das Cloudflare-Konto, 10 000 Neurons/Tag frei, danach 0,011 $ je 1000 Neurons).
    // Nur Text: Foto-Anfragen gehen direkt an das Ausweich-Modell, falls es Fotos kann.
    "@cf/meta/llama-4-scout-17b-16e-instruct": { "provider": "workers-ai", "displayName": "Llama 4 Scout", "vendor": "Cloudflare", "images": false,
      "price": { "in": 0.27, "out": 0.85 } },
    "@cf/meta/llama-3.3-70b-instruct-fp8-fast": { "provider": "workers-ai", "displayName": "Llama 3.3 70B", "vendor": "Cloudflare", "images": false,
      "price": { "in": 0.293, "out": 2.253 } },

    // OpenRouter (ein Schlüssel für viele Anbieter; Preis wie beim Original-Anbieter, OpenRouter nimmt beim Aufladen eine Gebühr).
    "anthropic/claude-sonnet-5.5": { "provider": "openrouter", "displayName": "Claude Sonnet 5.5", "vendor": "OpenRouter", "images": true,
      "price": { "in": 2, "out": 10, "cacheRead": 0.2, "cacheWrite": 2.5 } },
    "anthropic/claude-haiku-5.5": { "provider": "openrouter", "displayName": "Claude Haiku 5.5", "vendor": "OpenRouter", "images": true,
      "price": { "in": 0.10, "out": 0.50, "cacheRead": 0.01, "cacheWrite": 0.125 } },
    "anthropic/claude-opus-5.5": { "provider": "openrouter", "displayName": "Claude Opus 5.5", "vendor": "OpenRouter", "images": true,
      "price": { "in": 4, "out": 20, "cacheRead": 0.2, "cacheWrite": 5 } }
  },
  "presets": {
    "claude": {
      "description": "Alles Claude über Anthropic (bisheriger Stand)",
      "tiers": {
        "lite": { "model": "claude-haiku-5-5", "fallback": "claude-sonnet-5-5" },
        "standard": { "model": "claude-sonnet-5-5", "fallback": "claude-haiku-5-5" },
        "pro": { "model": "claude-opus-5-5", "fallback": "claude-sonnet-5-5" }
      }
    },
    "openai": {
      "description": "Alles OpenAI (GPT-5 mini, GPT-5)",
      "tiers": {
        "lite": { "model": "gpt-5-mini", "fallback": "gpt-5" },
        "standard": { "model": "gpt-5", "fallback": "gpt-5-mini" },
        "pro": { "model": "gpt-5", "fallback": "gpt-5-mini" }
      }
    },
    "gemini": {
      "description": "Alles Google Gemini",
      "tiers": {
        "lite": { "model": "gemini-3.6-flash", "fallback": null },
        "standard": { "model": "gemini-3.6-flash", "fallback": null },
        "pro": { "model": "gemini-3.6-flash", "fallback": null }
      }
    },
    "gratis": {
      "description": "Cloudflare Workers AI (für den Betreiber bis 10 000 Neurons/Tag kostenlos); Fotos über Claude Haiku",
      "tiers": {
        "lite": { "model": "@cf/meta/llama-4-scout-17b-16e-instruct", "fallback": "claude-haiku-5-5" },
        "standard": { "model": "@cf/meta/llama-4-scout-17b-16e-instruct", "fallback": "claude-haiku-5-5" },
        "pro": { "model": "@cf/meta/llama-3.3-70b-instruct-fp8-fast", "fallback": "claude-haiku-5-5" }
      }
    },
    "gemischt": {
      "description": "Günstig Gemini, Standard Claude Sonnet, Pro Claude Opus; Ausweichen über Anbietergrenzen",
      "tiers": {
        "lite": { "model": "gemini-3.6-flash", "fallback": "claude-haiku-5-5" },
        "standard": { "model": "claude-sonnet-5-5", "fallback": "gemini-3.6-flash" },
        "pro": { "model": "claude-opus-5-5", "fallback": "claude-sonnet-5-5" }
      }
    },
    "openrouter": {
      "description": "Claude über OpenRouter (ein Schlüssel)",
      "tiers": {
        "lite": { "model": "anthropic/claude-haiku-5.5", "fallback": "anthropic/claude-sonnet-5.5" },
        "standard": { "model": "anthropic/claude-sonnet-5.5", "fallback": "anthropic/claude-haiku-5.5" },
        "pro": { "model": "anthropic/claude-opus-5.5", "fallback": "anthropic/claude-sonnet-5.5" }
      }
    }
  }
}
